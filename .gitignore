# CDS credentials. Never commit: the file carries a personal API key.
.cdsapirc

# Retrieved data and fitted results. ERA5/CEMS archives run to many GB and are
# reproducible from run_prototype.py --step download, so they stay out of git.
# Tracked as empty directories, via .gitkeep below. If they do not exist when
# compose starts, Docker creates them itself and the container user cannot
# write to the result - the download then fails after the retrieval succeeds,
# which is an expensive way to find out. Note `data/*` rather than `data/`:
# git will not descend into an ignored directory, so the negation below only
# works if the directory itself is not the thing being ignored.
data/*
out/*
!data/.gitkeep
!out/.gitkeep

# The ICNF occurrence record is a fixed input, not a retrieval artefact: it is
# small, it is not reproducible from any API, and every fire-layer number
# depends on this exact extract. Track it.
!data/ocoPT_*.csv
*.nc
*.nc4
*.grib
*.grb
*.pkl
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
